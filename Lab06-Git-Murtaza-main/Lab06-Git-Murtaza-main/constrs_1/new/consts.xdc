## Clock Signal (100 MHz System Clock)
set_property PACKAGE_PIN W5 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports clk]

## Switches SW[3:0]
set_property PACKAGE_PIN V17 [get_ports {sw[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[0]}]
set_property PACKAGE_PIN V16 [get_ports {sw[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[1]}]
set_property PACKAGE_PIN W16 [get_ports {sw[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[2]}]
set_property PACKAGE_PIN W17 [get_ports {sw[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[3]}]

## Buttons (btn_action = Center Button btnC, btn_reset = Top Button btnU)
set_property PACKAGE_PIN U18 [get_ports btn_action]
set_property IOSTANDARD LVCMOS33 [get_ports btn_action]
set_property PACKAGE_PIN T18 [get_ports btn_reset]
set_property IOSTANDARD LVCMOS33 [get_ports btn_reset]

## LEDs for ALU Result (LED0 to LED15)
set_property PACKAGE_PIN U16 [get_ports {led_result[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[0]}]
set_property PACKAGE_PIN E19 [get_ports {led_result[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[1]}]
set_property PACKAGE_PIN U19 [get_ports {led_result[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[2]}]
set_property PACKAGE_PIN V19 [get_ports {led_result[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[3]}]
set_property PACKAGE_PIN W18 [get_ports {led_result[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[4]}]
set_property PACKAGE_PIN U15 [get_ports {led_result[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[5]}]
set_property PACKAGE_PIN U14 [get_ports {led_result[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[6]}]
set_property PACKAGE_PIN V14 [get_ports {led_result[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[7]}]
set_property PACKAGE_PIN V13 [get_ports {led_result[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[8]}]
set_property PACKAGE_PIN V3  [get_ports {led_result[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[9]}]
set_property PACKAGE_PIN W3  [get_ports {led_result[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[10]}]
set_property PACKAGE_PIN U3  [get_ports {led_result[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[11]}]
set_property PACKAGE_PIN P3  [get_ports {led_result[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[12]}]
set_property PACKAGE_PIN N3  [get_ports {led_result[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[13]}]
set_property PACKAGE_PIN P1  [get_ports {led_result[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[14]}]
set_property PACKAGE_PIN L1  [get_ports {led_result[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_result[15]}]

## LED for Zero Flag (Mapped to 7-segment Decimal Point V7 to prevent conflict with LED15)
set_property PACKAGE_PIN V7 [get_ports led_zero]
set_property IOSTANDARD LVCMOS33 [get_ports led_zero]